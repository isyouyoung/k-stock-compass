# =========================================================
# MariaDB 연결
# =========================================================
spring.datasource.url=jdbc:mariadb://localhost:3306/kstockdb
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.mariadb.jdbc.Driver

# JPA/Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true

# JWT 설정
jwt.secret=${JWT_SECRET}
jwt.expiration=600000
jwt.refresh-expiration=60480000

# Redis 설정
spring.data.redis.host=127.0.0.1
spring.data.redis.port=6379

# 이메일 발송 설정 (Gmail SMTP)
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=${MAIL_USERNAME}
spring.mail.password=${MAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# 외부 API Keys
public.api.stock.key=${PUBLIC_API_STOCK_KEY}
kis.api.app-key=${KIS_API_APP_KEY}
kis.api.app-secret=${KIS_API_APP_SECRET}
dart.api.key=${DART_API_KEY}
gemini.api.key=${GEMINI_API_KEY}
weather.api.service-key=${WEATHER_API_SERVICE_KEY}
weather.api.url=http://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getUltraSrtNcst
naver.openapi.client-id=${NAVER_CLIENT_ID}
naver.openapi.client-secret=${NAVER_CLIENT_SECRET}
bok.api.key=${BOK_API_KEY}

# Logging & Redis Cache Config
logging.level.root=WARN
logging.level.kopo.kstockcompass=INFO
spring.jackson.deserialization.fail-on-unknown-properties=false